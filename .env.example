# Required — Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required — Meilisearch master key (min 16 chars); must match the value
# passed to the meilisearch service in docker-compose.yml
MEILI_MASTER_KEY=your-strong-master-key-min-16-chars

# Optional — service hostnames (defaults match docker-compose.yml)
REDIS_HOST=redis
# MEILI_HOST=http://meilisearch:7700

# Optional — Telegram user ID of the bot owner. Gates /botstats only;
# it grants no per-scope permissions.
# SUPER_ADMIN_ID=123456789
